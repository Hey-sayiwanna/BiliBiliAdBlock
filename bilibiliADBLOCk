[Map Local]
# 默认搜索词：完整空 gRPC 响应，无需请求脚本
^https?://(?:grpc\.biliapi\.net|app\.(?:bilibili\.com|biliapi\.(?:net|com)))/bilibili\.app\.interface\.v1\.Search/DefaultWords(?:\?.*)?$ data-type=base64 data="AAAAAAA=" status-code=200 header="Content-Type:application/grpc|Content-Length:5|grpc-status:0"

# 番剧活动弹窗
^https?://api\.(?:bilibili\.com|biliapi\.net)/pgc/activity/deliver/material/receive(?:\?.*)?$ data-type=text data="{\"code\":0,\"data\":{\"closeType\":\"close_win\",\"container\":[],\"showTime\":\"\"},\"message\":\"success\"}" header="Content-Type:application/json"

[Body Rewrite]
# iPad 番剧推荐广告
http-response-jq ^https?://api\.(?:bilibili\.com|biliapi\.net)/pgc/view/v2/app/season(?:\?.*)?$ 'del(.data.payment)'

